{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/atlas-package/v0.1/schema.json",
  "title": "Atlas Package v0.1 structural schema",
  "type": "object",
  "required": ["manifest", "sources", "world", "layouts", "artInventory"],
  "properties": {
    "manifest": {"$ref": "#/$defs/manifest"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "world": {"$ref": "#/$defs/world"},
    "layouts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/layout"}},
    "artInventory": {"type": "array", "items": {"$ref": "#/$defs/artLayer"}},
    "interpretations": {"type": "array", "items": {"$ref": "#/$defs/interpretation"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "status": {"type": "string", "enum": ["explicit", "inferred", "imagined"]},
    "provenance": {"type": "object", "required": ["documentId", "sectionId", "locator"], "properties": {"documentId": {"$ref": "#/$defs/id"}, "sectionId": {"$ref": "#/$defs/id"}, "locator": {"type": "object", "required": ["kind"], "properties": {"kind": {"type": "string", "enum": ["section", "page", "paragraph", "span", "pdf-rectangle"]}}, "additionalProperties": true}}, "additionalProperties": false},
    "discovery": {"type": "object", "required": ["becomesVisibleAt"], "properties": {"becomesVisibleAt": {"$ref": "#/$defs/provenance"}, "visibilityPolicy": {"type": "string", "enum": ["not-rendered-before-discovery", "dimmed-before-discovery"]}}, "additionalProperties": false},
    "manifest": {"type": "object", "required": ["format", "formatVersion", "packageId", "entrypoints"], "properties": {"format": {"const": "atlas-package"}, "formatVersion": {"const": "0.1"}, "packageId": {"$ref": "#/$defs/id"}, "entrypoints": {"type": "object", "required": ["world", "defaultLayout"], "properties": {"world": {"type": "string"}, "defaultLayout": {"type": "string"}, "artInventory": {"type": "string"}}}}, "additionalProperties": true},
    "source": {"type": "object", "required": ["id", "title", "sections"], "properties": {"id": {"$ref": "#/$defs/id"}, "title": {"type": "string"}, "sections": {"type": "array", "items": {"type": "object", "required": ["id", "label"], "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"type": "string"}}}}}, "additionalProperties": true},
    "entity": {"type": "object", "required": ["id", "name", "entityKind", "status", "provenance", "discovery"], "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string"}, "entityKind": {"const": "place"}, "placeKind": {"type": "string"}, "parentRef": {"$ref": "#/$defs/id"}, "mapBehavior": {"type": "object", "properties": {"mobility": {"enum": ["fixed", "mobile", "temporary", "unknown"]}, "coordinatePolicy": {"enum": ["layout-anchor-allowed", "scene-context-only", "no-coordinate-claim"]}}}, "status": {"$ref": "#/$defs/status"}, "provenance": {"$ref": "#/$defs/provenance"}, "discovery": {"$ref": "#/$defs/discovery"}}, "additionalProperties": true},
    "claim": {"type": "object", "required": ["id", "claimType", "subjectRef", "predicate", "objectRefs", "status", "provenance"], "properties": {"id": {"$ref": "#/$defs/id"}, "claimType": {"enum": ["spatial", "visual"]}, "subjectRef": {"$ref": "#/$defs/id"}, "predicate": {"type": "string"}, "objectRefs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}, "status": {"$ref": "#/$defs/status"}, "provenance": {"$ref": "#/$defs/provenance"}}, "additionalProperties": true},
    "travelRule": {"type": "object", "required": ["id", "travelKind", "fromRef", "toRef", "status", "provenance", "discovery"], "properties": {"id": {"$ref": "#/$defs/id"}, "travelKind": {"enum": ["stated-route", "narrative-journey", "fixed-portal", "temporary-portal", "flight-transition", "water-journey", "special-air-transit", "directed-magical-transition", "frame-transition"]}, "fromRef": {"$ref": "#/$defs/id"}, "toRef": {"$ref": "#/$defs/id"}, "status": {"$ref": "#/$defs/status"}, "provenance": {"$ref": "#/$defs/provenance"}, "discovery": {"$ref": "#/$defs/discovery"}}, "additionalProperties": true},
    "world": {"type": "object", "required": ["entities", "claims", "travelRules"], "properties": {"entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}}, "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}}, "travelRules": {"type": "array", "items": {"$ref": "#/$defs/travelRule"}}}, "additionalProperties": true},
    "layout": {"type": "object", "required": ["id", "kind", "orientation", "coordinateSystem", "elements"], "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["regional-atlas", "topological-atlas", "local-atlas"]}, "orientation": {"type": "object", "required": ["mode"], "properties": {"mode": {"enum": ["north-up", "not-applicable", "custom"]}}}, "coordinateSystem": {"type": "object", "required": ["type", "coordinateMeaning"], "properties": {"type": {"enum": ["normalized", "diagrammatic"]}, "coordinateMeaning": {"const": "cartographic-interpretation"}}}, "parentLayoutRef": {"$ref": "#/$defs/id"}, "focusRef": {"$ref": "#/$defs/id"}, "elements": {"type": "array", "items": {"type": "object", "required": ["id", "kind", "discovery", "status"], "properties": {"id": {"$ref": "#/$defs/id"}, "entityRef": {"$ref": "#/$defs/id"}, "travelRuleRef": {"$ref": "#/$defs/id"}, "kind": {"type": "string"}, "anchor": {"type": "object", "properties": {"x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "minimum": 0, "maximum": 1}}}, "discovery": {"$ref": "#/$defs/discovery"}, "status": {"$ref": "#/$defs/status"}}, "additionalProperties": true}}}, "additionalProperties": true},
    "artLayer": {"type": "object", "required": ["id", "kind", "asset", "discovery", "status"], "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"type": "string"}, "asset": {"type": "string"}, "entityRef": {"$ref": "#/$defs/id"}, "discovery": {"$ref": "#/$defs/discovery"}, "status": {"const": "imagined"}, "interpretationKind": {"const": "cartographic-interpretation"}}, "additionalProperties": true},
    "interpretation": {"type": "object", "required": ["id", "kind", "appliesToRef", "rationale", "status"], "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"type": "string"}, "appliesToRef": {"$ref": "#/$defs/id"}, "rationale": {"type": "string"}, "supportedByRefs": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "status": {"const": "imagined"}}, "additionalProperties": true}
  }
}
